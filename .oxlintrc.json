{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["legacy/**", "dist/**"],
  "plugins": ["react", "oxc"],
  "env": { "browser": true, "es2024": true },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // A reference to a variable that doesn't exist is a blank screen at
    // runtime, and neither Vite nor the type-free build catches it. This
    // rule does, which is worth an error rather than a warning.
    "no-undef": "error"
  }
}
